---
import { siteConfig } from '@/config/site';
import { socialLinks } from '@/config/social';
---

<footer class="mt-auto border-t border-border-soft">
	<div class="page-shell flex flex-col gap-3 py-8 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
		<p>© {new Date().getFullYear()} {siteConfig.author.name}</p>
		<ul class="flex flex-wrap gap-x-5 gap-y-2">
			{
				socialLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="transition-colors hover:text-text-main"
							rel={link.href.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
