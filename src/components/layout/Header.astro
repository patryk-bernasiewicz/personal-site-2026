---
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import SiteLogo from '@/components/layout/SiteLogo.astro';
import { siteConfig } from '@/config/site';
import { getDictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/i18n/locales';
import type { RouteKey, StaticRouteKey } from '@/lib/i18n/routes';
import { getLocalizedRoute } from '@/lib/i18n/urls';

interface Props {
	locale: Locale;
	routeKey: RouteKey | 'blogPost';
	alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, routeKey, alternatePaths } = Astro.props;
const dictionary = getDictionary(locale);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navItems: { routeKey: StaticRouteKey; label: string }[] = [
	{ routeKey: 'resume', label: dictionary.nav.resume },
	{ routeKey: 'blogIndex', label: dictionary.nav.blog },
];

function isActive(href: string): boolean {
	return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="page-shell flex min-h-[var(--spacing-nav-h)] items-center justify-between gap-6">
	<a
		href={getLocalizedRoute('home', locale)}
		class="flex items-center gap-3 rounded-xs font-semibold text-text-main focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
	>
		<SiteLogo class="size-8" />
		<span class="hidden sm:inline">{siteConfig.name}</span>
		<span class="sr-only sm:hidden">{dictionary.nav.home}</span>
	</a>

	<nav aria-label={dictionary.nav.main}>
		<ul class="flex items-center gap-5 text-sm font-medium">
			{
				navItems.map((item) => {
					const href = getLocalizedRoute(item.routeKey, locale);
					const active = isActive(href);
					return (
						<li>
							<a
								href={href}
								aria-current={active ? 'page' : undefined}
								class:list={[
									'transition-colors',
									active ? 'text-accent' : 'text-text-muted hover:text-text-main',
								]}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
			<li class="border-l border-border-soft pl-5">
				<LanguageSwitcher {locale} {routeKey} {alternatePaths} />
			</li>
		</ul>
	</nav>
</header>
