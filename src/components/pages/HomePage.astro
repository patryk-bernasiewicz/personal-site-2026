---
import HomeIntro from '@/components/sections/home/HomeIntro.astro';
import LatestPostsSection from '@/components/sections/home/LatestPostsSection.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getLatestBlogPosts } from '@/lib/contentful/queries';
import { getDictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/i18n/locales';
import { getAlternateRoutes, getLocalizedRoute } from '@/lib/i18n/urls';
import { buildPageMetadata } from '@/lib/seo';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const latestPosts = await getLatestBlogPosts(5, locale);

const metadata = buildPageMetadata({
	title: dictionary.meta.home.title,
	description: dictionary.meta.home.description,
	locale,
	canonical: getLocalizedRoute('home', locale),
	alternatePaths: getAlternateRoutes('home'),
});
---

<PageLayout {metadata} routeKey="home">
	<HomeIntro {locale} />
	<LatestPostsSection {locale} posts={latestPosts} />
</PageLayout>
