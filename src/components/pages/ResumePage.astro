---
import ResumeExperience from '@/components/sections/resume/ResumeExperience.astro';
import ResumeSkills from '@/components/sections/resume/ResumeSkills.astro';
import { getResume } from '@/config/resume-content';
import ResumeLayout from '@/layouts/ResumeLayout.astro';
import { getDictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/i18n/locales';
import { getAlternateRoutes, getLocalizedRoute } from '@/lib/i18n/urls';
import { buildPageMetadata } from '@/lib/seo';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const { intro } = getResume(locale);

const metadata = buildPageMetadata({
	title: dictionary.meta.resume.title,
	description: dictionary.meta.resume.description,
	locale,
	canonical: getLocalizedRoute('resume', locale),
	alternatePaths: getAlternateRoutes('resume'),
});
---

<ResumeLayout {metadata}>
	<div class="page-shell section-gap">
		<h1 class="font-display text-page-title font-semibold text-text-main">{dictionary.resume.title}</h1>
		<p class="mt-3 text-body-large text-text-soft">{intro}</p>
		<ResumeExperience {locale} />
		<ResumeSkills {locale} />
	</div>
</ResumeLayout>
