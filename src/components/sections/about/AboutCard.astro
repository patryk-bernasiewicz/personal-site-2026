---
import { classNames } from '@/lib/classNames';

interface Props {
	tag?: 'article' | 'div';
	href?: string;
	external?: boolean;
	class?: string;
}

const { tag = 'article', href, external = false, class: className = '' } = Astro.props;
const Tag = href ? 'a' : tag;
const attrs = href
	? {
			href,
			target: external ? '_blank' : undefined,
			rel: external ? 'noopener noreferrer' : undefined,
		}
	: {};

const baseClass =
	'relative block h-full overflow-hidden rounded-[0.5rem] border border-[color-mix(in_srgb,var(--color-text-main)_12.5%,transparent)] bg-surface text-inherit no-underline  before:pointer-events-none before:absolute before:inset-0 before:bg-surface before:opacity-0 before:transition-opacity before:duration-200 before:content-[\'\'] motion-reduce:transition-none';

const linkClass =
	'transition duration-200 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--color-text-main)_34%,transparent)]  hover:before:opacity-100 focus-visible:-translate-y-0.5 focus-visible:border-[color-mix(in_srgb,var(--color-text-main)_34%,transparent)]  focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent focus-visible:before:opacity-100 motion-reduce:hover:translate-y-0 motion-reduce:focus-visible:translate-y-0';
---

<Tag
	{...attrs}
	class={classNames(baseClass, href && linkClass, className)}
>
	<slot />
</Tag>
