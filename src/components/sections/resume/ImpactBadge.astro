---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<span class="dcv-impact-badge">{label}</span>

<style>
	.dcv-impact-badge {
		display: inline-flex;
		border: 1px solid color-mix(in srgb, var(--color-text-main) 19%, transparent);
		border-radius: 999px;
		padding: 0.32rem 0.72rem;
		color: var(--color-accent-hover);
		background: color-mix(in srgb, var(--color-text-main) 4%, transparent);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
