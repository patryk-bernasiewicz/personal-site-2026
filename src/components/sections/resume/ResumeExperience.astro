---
import { getResume } from '@/config/resume-content';
import { formatMonthDuration, formatMonthPeriod } from '@/lib/dates';
import { getDictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/i18n/locales';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const { roles } = getResume(locale);
---

<section class="mt-12" aria-labelledby="experience-heading">
	<h2 id="experience-heading" class="font-display text-section-title font-semibold text-text-main">
		{dictionary.resume.experienceTitle}
	</h2>
	<ol class="mt-4 divide-y divide-border-soft border-y border-border-soft">
		{
			roles.map((role) => (
				<li class="py-6">
					<article>
						<h3 class="font-semibold text-text-main">
							{role.role} · <span class="font-normal text-text-soft">{role.company}</span>
						</h3>
						<p class="mt-1 text-sm text-text-faint">
							{formatMonthPeriod(role.start, role.end, locale)} · {formatMonthDuration(role.start, role.end, locale)}
						</p>
						<p class="mt-3 text-body text-text-soft">{role.summary}</p>
						<ul class="mt-3 list-disc space-y-1 pl-5 text-body text-text-muted marker:text-text-faint">
							{role.points.map((point) => <li>{point}</li>)}
						</ul>
						<p class="mt-3 text-sm text-text-faint">{role.stack.join(' · ')}</p>
					</article>
				</li>
			))
		}
	</ol>
</section>
